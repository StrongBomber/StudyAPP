# API anahtarını içeren yapılandırma dosyalarına ve hata günlüğüne
# doğrudan tarayıcı erişimini engelle. (Günlük anahtar içermez ama
# yine de yalnızca teşhis sayfası üzerinden okunmalıdır.)
<FilesMatch "^(config(\.sample)?\.php|debug\.log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
