# Copy this file to .env in the project root or htdocs/ on InfinityFree.
# Direct HTTP access to the real .env file is blocked by the root .htaccess.
# No API key is included. Add your private NVIDIA NIM key on the server only.
AI_ENABLED=true
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3-flash
AI_RATE_LIMIT_PER_HOUR=30
